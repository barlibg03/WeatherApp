<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- SwipeRefreshLayout трябва да обгражда scroll view поотделно в реален проект -->
    <!-- За простота тук използваме NestedScrollView -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ── Прогрес при зареждане ── -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="true"
            android:visibility="gone"
            android:progressTint="@color/white"
            android:indeterminateTint="@color/white" />

        <!-- ── Грешка ── -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_error_card"
            android:padding="12dp"
            android:text="Грешка при зареждане"
            android:textColor="@color/error_text"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- ── Търсачка и GPS ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Търси град..."
                android:textColorHint="@color/white_50"
                android:textColor="@color/white"
                android:background="@drawable/bg_search_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_search"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Търси" />

            <ImageButton
                android:id="@+id/btnMyLocation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_location"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Моята локация" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_refresh"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Обнови" />
        </LinearLayout>

        <!-- ── Икона и Температура ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/ivWeatherIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="Икона на времето"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="72sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="-0.05"
                tools:text="21°C" />

            <TextView
                android:id="@+id/tvCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="София, BG" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/white_80"
                android:layout_marginTop="4dp"
                tools:text="Слънчево" />

            <TextView
                android:id="@+id/tvFeelsLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/white_60"
                android:layout_marginTop="4dp"
                tools:text="Усеща се като 23°C" />

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/white_60"
                android:layout_marginTop="2dp"
                tools:text="Неделя, 27 апр • 09:41" />
        </LinearLayout>

        <!-- ── Статистики ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/white_15"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Влажност -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💧" android:textSize="20sp"/>
                    <TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/white"
                        android:textSize="16sp" android:textStyle="bold" tools:text="62%"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Влажност" android:textColor="@color/white_60" android:textSize="10sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/white_15"/>

                <!-- Вятър -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💨" android:textSize="20sp"/>
                    <TextView android:id="@+id/tvWindSpeed" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/white"
                        android:textSize="16sp" android:textStyle="bold" tools:text="14 км/ч"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Вятър" android:textColor="@color/white_60" android:textSize="10sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/white_15"/>

                <!-- Видимост -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👁️" android:textSize="20sp"/>
                    <TextView android:id="@+id/tvVisibility" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/white"
                        android:textSize="16sp" android:textStyle="bold" tools:text="10 км"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Видимост" android:textColor="@color/white_60" android:textSize="10sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/white_15"/>

                <!-- Изгрев/Залез -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌅" android:textSize="20sp"/>
                    <TextView android:id="@+id/tvSunrise" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/white"
                        android:textSize="13sp" android:textStyle="bold" tools:text="06:23"/>
                    <TextView android:id="@+id/tvSunset" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/white_60"
                        android:textSize="13sp" tools:text="20:47"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Часова Прогноза ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="ПО ЧАСОВЕ"
            android:textColor="@color/white_60"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHourly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_hourly_forecast" />

        <!-- ── 5-дневна Прогноза ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="5-ДНЕВНА ПРОГНОЗА"
            android:textColor="@color/white_60"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/white_15"
            app:cardElevation="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_daily_forecast" />

        </androidx.cardview.widget.CardView>

        <!-- ── Мерна Единица ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="16dp">

            <Button
                android:id="@+id/btnCelsius"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="°C"
                android:textColor="@color/white"
                android:background="@drawable/bg_unit_btn_selected"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnFahrenheit"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="°F"
                android:textColor="@color/white_60"
                android:background="@drawable/bg_unit_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
